#!/usr/bin/env bash

usage() {
  cat <<'HELP'
homelab-backup - daily copy of the main storage and the boot drive's configs.

Runs from root's crontab at 6:00. What it does, in order:
  1. dumps the Nextcloud database
  2. copies the main storage to the backup storage with rsync
     (files you delete or replace are moved to _deleted/<date>/ and kept 30 days)
  3. copies the boot drive's configs
  4. removes dumps and _deleted folders older than 30 days

Settings can be overridden in /etc/homelab-backup.conf (see the guide).
The result of each run is saved in /var/lib/homelab-backup/last-run as
  date|result|destination|seconds|bytes   (bytes = size of the whole backup folder)

Every run also checks a sample of the copied files against the originals (the files copied
in this run first, then a different random sample each night, up to VERIFY_MB megabytes,
2048 by default, 0 turns it off). A copy that differs is copied again, and the run says so.

A verify run also records its result (/var/lib/homelab-backup/last-verify). `homelab` and the
bell show it while a copy still differs, until a later verify finds every file matching.

Exit codes: 0 done, 1 the run found problems, 2 a wrong word on the command line, 3 another backup was already running (nothing was started).

Usage:
  sudo homelab-backup           run the backup now (about a minute, longer after many new files)
  sudo homelab-backup verify    compare EVERY file of the backup with the original and list the ones that differ
                                (reads all the data on both drives, so it can take hours)
  sudo homelab-backup verify --repair   the same, and copy the files that differ again
  homelab-backup help           this text (nothing is started)
  homelab-backup version
It takes no other options: anything else is refused, so a typo can never start a backup by accident.
Watch a backup while it runs:  sudo tail -f /var/log/homelab-backup.log
HELP
}

VERSION="1.3"
MODE=backup
REPAIR=0
case "${1-x}" in
  x) ;;
  verify) MODE=verify; [ "${2:-}" = "--repair" ] && REPAIR=1
          if [ -n "${2:-}" ] && [ "$REPAIR" = 0 ]; then echo "homelab-backup: unknown option '$2'. Use: sudo homelab-backup verify [--repair]" >&2; exit 2; fi ;;
  "") echo "homelab-backup: an empty argument was given. Nothing was started." >&2
      echo "To run the backup now:  sudo homelab-backup      For help:  homelab-backup help" >&2; exit 2 ;;
  -h | --help | help) usage; exit 0 ;;
  version | --version) echo "homelab-backup $VERSION"; exit 0 ;;
  *) echo "homelab-backup: unknown option '$1'. Nothing was started." >&2
     echo "To run the backup now:  sudo homelab-backup      For help:  homelab-backup help" >&2; exit 2 ;;
esac

set -u
set -o pipefail
export PATH="${HOMELAB_EXTRA_PATH:+$HOMELAB_EXTRA_PATH:}/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"

SRC="/mnt/storage"
DEST_POOL="/mnt/backup"
DEST_FALLBACK=""
RETENTION_DAYS=30
LOGFILE="/var/log/homelab-backup.log"
STATUS_FILE="/var/lib/homelab-backup/last-run"
VERIFY_STATUS_FILE=""
NEXTCLOUD_DB_CONTAINER="nextcloud_db"
NEXTCLOUD_DB_USER="nextcloud"
NEXTCLOUD_DB_NAME="nextcloud"
MIN_FREE_GB=20
VERIFY_MB=2048
LAB_USER="${HOMELAB_USER:-$(getent passwd 1000 | cut -d: -f1)}"
LAB_HOME="$(getent passwd "$LAB_USER" 2>/dev/null | cut -d: -f6)"
LAB_HOME="${LAB_HOME:-/home/$LAB_USER}"
CONFIG_PATHS=(
  "$LAB_HOME/homepage-config"
  "$LAB_HOME/nextcloud/html"
  /opt/adguard-docker
  /var/lib/docker/volumes/portainer_data
  /var/lib/docker/volumes/beszel_beszel_data
  /var/lib/docker/volumes/filebrowser_filebrowser_data
  /etc/fstab
  /etc/systemd/system/docker.service.d
  /usr/local/sbin/drives
  /usr/local/sbin/homelab-backup
)

CONF="${BACKUP_CONF:-/etc/homelab-backup.conf}"
# shellcheck disable=SC1090
[ -f "$CONF" ] && . "$CONF"

VERIFY_STATUS_FILE="${VERIFY_STATUS_FILE:-$(dirname "$STATUS_FILE")/last-verify}"
START=$(date +%s)
TODAY=$(date +%F)
VCOMPARED=0
VDIFF=0
VFIXED=0
VCHANGED=0
VGONE=0
NEWER_N=0
VDRIVES=""
ERRORS=0
NOTES=""
DEST=""
DEST_SHOWN=""

log() { printf '%s %s\n' "$(date '+%F %T')" "$*" >>"$LOGFILE"; }
fail() { ERRORS=$((ERRORS + 1)); NOTES="$NOTES$*; "; log "ERROR: $*"; }
# Decide whether an rsync exit code is acceptable. Code 24 means some files disappeared while copying, which is not an error.
rsync_ok() { [ "$1" -eq 0 ] || [ "$1" -eq 24 ]; }

finish() {
  local result=OK secs=$(( $(date +%s) - START )) size=""
  [ "$ERRORS" -eq 0 ] || result="FAILED ($ERRORS problem(s): ${NOTES%; })"
  if [ "$MODE" = verify ]; then
    log "verify finished: $result in ${secs}s"
    if [ "$ERRORS" -eq 0 ]; then
      if [ "$VFIXED" -gt 0 ]; then echo "Verify finished: $VFIXED file(s) differed, were copied again, and now every file matches (${secs}s)." >&2
      else echo "Verify finished: every file matches (${secs}s)." >&2; fi
      [ "$VCHANGED" -gt 0 ] && echo "$VCHANGED file(s) were changed after the last backup. That is normal: the next backup copies them." >&2
    else echo "Verify found problems: ${NOTES%; }" >&2; fi
    mkdir -p "$(dirname "$VERIFY_STATUS_FILE")"
    printf '%s|%s|%s|%s|%s|%s|%s\n' "$(date '+%F %H:%M')" "$result" "$VCOMPARED" "$VDIFF" "$VFIXED" "$VDRIVES" "$VCHANGED" >"$VERIFY_STATUS_FILE"
    [ "$ERRORS" -eq 0 ]
    exit $?
  fi
  if [ -n "$DEST" ] && [ -d "$DEST" ]; then size=$(timeout 300 du -sbD "$DEST" 2>/dev/null | awk '{print $1}'); fi
  mkdir -p "$(dirname "$STATUS_FILE")"
  printf '%s|%s|%s|%s|%s\n' "$(date '+%F %H:%M')" "$result" "${DEST_SHOWN:-${DEST:-none}}" "$secs" "$size" >"$STATUS_FILE"
  log "finished: $result in ${secs}s"
  if [ -t 2 ]; then
    if [ "$ERRORS" -eq 0 ]; then echo "Backup finished: OK (${secs}s)." >&2
    else echo "Backup FAILED: ${NOTES%; }" >&2; echo "Details:  sudo tail -20 $LOGFILE" >&2; fi
  fi
  if [ -f "$LOGFILE" ] && [ "$(stat -c %s "$LOGFILE")" -gt 5242880 ]; then
    tail -n 2000 "$LOGFILE" >"$LOGFILE.tmp" && mv "$LOGFILE.tmp" "$LOGFILE"
  fi
  [ "$ERRORS" -eq 0 ]
  exit $?
}

[ "$(id -u)" = 0 ] || { echo "Run as root: sudo homelab-backup"; exit 1; }
mkdir -p "$(dirname "$LOGFILE")"
exec 8>/var/lock/homelab-backup.lock
if ! flock -n 8; then
  log "another backup is already running; skipping"
  if [ -t 2 ]; then echo "Another backup is already running, so this one was not started. Watch it with:  sudo tail -f $LOGFILE" >&2; fi
  exit 3
fi
log "start"

# Make the next read come from the drives, not from memory, so a damaged copy cannot hide behind the cache.
drop_caches() { sync; { echo 3 >/proc/sys/vm/drop_caches; } 2>/dev/null || true; }

# verify_list SRC DEST_MAIN CHANGED_FILE BUDGET_MB: print (NUL-separated) the files to compare: the ones copied in this run first, then a random sample, up to the size budget.
# A file that changed on Main after this run started is skipped: it differs because the app wrote to it, not because the drive damaged the copy.
verify_list() {
  python3 - "$@" <<'PY'
import os, random, sys
src, dst, changed, budget = sys.argv[1], sys.argv[2], sys.argv[3], int(sys.argv[4]) * 1048576
since = float(os.environ.get("VERIFY_SINCE") or 0)
picked, seen, used = [], set(), 0
def add(rel):
    global used
    if rel in seen:
        return False
    try:
        a, b = os.lstat(os.path.join(src, rel)), os.lstat(os.path.join(dst, rel))
    except OSError:
        return False
    if not (os.path.isfile(os.path.join(src, rel)) and not os.path.islink(os.path.join(src, rel))) or a.st_size == 0:
        return False
    if since and a.st_mtime >= since:
        return False
    if picked and used + a.st_size > budget:
        return False
    seen.add(rel); picked.append(rel); used += a.st_size
    return True
try:
    names = [n.decode("utf-8", "surrogateescape") for n in open(changed, "rb").read().split(b"\0") if n]
except OSError:
    names = []
for n in names:
    add(n)
rest = []
for d, _dirs, files in os.walk(dst):
    for f in files:
        rest.append(os.path.relpath(os.path.join(d, f), dst))
random.shuffle(rest)
for rel in rest:
    if used >= budget:
        break
    add(rel)
sys.stdout.buffer.write(b"\0".join(p.encode("utf-8", "surrogateescape") for p in picked))
PY
}

# rsync_names PATTERN: read rsync's output lines, keep the lines for copied files (">f...") and print each file name NUL-terminated.
# rsync writes a name with a newline, a backslash or (without a UTF-8 locale, as under cron) an accent as \#ooo (octal); this turns them back into the real bytes.
rsync_names() {
  python3 -c '
import re, sys
pat = re.compile(rb"^>f[^ |]*[ |]")
esc = re.compile(rb"\\#([0-7]{3})")
out = sys.stdout.buffer
for line in sys.stdin.buffer.read().split(b"\n"):
    m = pat.match(line)
    if m:
        out.write(esc.sub(lambda e: bytes([int(e.group(1), 8) & 255]), line[m.end():]) + b"\0")
'
}

# nul_count LIST: how many names a NUL-separated list holds.
nul_count() { tr -cd '\0' <"$1" | wc -c; }

# show_names LIST N: print the first N names of a NUL-separated list, one per line (a newline or other odd character inside a name is shown as an escape).
show_names() {
  python3 -c '
import sys
data = open(sys.argv[1], "rb").read().split(b"\0")
for n in [x for x in data if x][: int(sys.argv[2])]:
    print(n.decode("utf-8", "replace").encode("unicode_escape").decode("ascii") if any(c < 32 or c == 127 for c in n) else n.decode("utf-8", "replace"))
' "$1" "$2"
}

# differing_files LIST: the files in LIST (NUL-separated) whose content is not the same in the backup as in the original (printed NUL-separated).
differing_files() {
  rsync -rn --checksum --itemize-changes --from0 --files-from="$1" "$SRC/" "$DEST/main/" 2>>"$LOGFILE" | rsync_names
}

# drives_holding LIST: the backup drives (their folder names under /mnt/disks) that hold the files in LIST (NUL-separated).
drives_holding() {
  local f d seen=""
  while IFS= read -r -d '' f; do
    for d in "${HOMELAB_DISKS_DIR:-/mnt/disks}"/BACKUP*; do
      [ -e "$d/main/$f" ] || continue
      case " $seen " in *" $(basename "$d") "*) ;; *) seen="$seen $(basename "$d")" ;; esac
    done
  done <"$1"
  echo "${seen# }"
}

# names_in_both LIST1 LIST2: how many names two NUL-separated lists have in common.
names_in_both() {
  [ -s "$2" ] || { echo 0; return; }
  comm -z -12 <(LC_ALL=C sort -z "$1") <(LC_ALL=C sort -z "$2") | tr -cd '\0' | wc -c
}

# drop_changed LIST: remove from LIST (NUL-separated) the files that were written after this run started. A changed original is not a damaged copy.
drop_changed() {
  local f m keep
  keep=$(mktemp) || return 0
  while IFS= read -r -d '' f; do
    m=$(stat -c %Y "$SRC/$f" 2>/dev/null) || continue
    [ "$m" -ge "$START" ] 2>/dev/null && continue
    printf '%s\0' "$f"
  done <"$1" >"$keep"
  cat "$keep" >"$1"
  rm -f "$keep"
}

# verify_sample CHANGED_FILE: compare a sample of the backup with the originals and copy again what differs.
verify_sample() {
  [ "$VERIFY_MB" -gt 0 ] 2>/dev/null || return 0
  local list bad n total
  list=$(mktemp) || return 0
  VERIFY_SINCE="$START" verify_list "$SRC" "$DEST/main" "$1" "$VERIFY_MB" >"$list" 2>>"$LOGFILE"
  total=$(tr -cd '\0' <"$list" | wc -c)
  if [ ! -s "$list" ]; then rm -f "$list"; return 0; fi
  total=$((total + 1))
  drop_caches
  bad=$(mktemp) || { rm -f "$list"; return 0; }
  differing_files "$list" >"$bad"
  n=$(nul_count "$bad")
  drop_changed "$bad"
  [ "$n" -gt "$(nul_count "$bad")" ] && log "verify: $(( n - $(nul_count "$bad") )) file(s) were changed while the backup ran, so they are not counted as damaged"
  if [ -s "$bad" ]; then
    n=$(nul_count "$bad")
    VDRIVES=$(drives_holding "$bad")
    log "verify: $n of $total checked file(s) differ from the originals, copying them again${VDRIVES:+ (held by $VDRIVES)}"
    rsync -aH --numeric-ids --checksum --from0 --files-from="$bad" "$SRC/" "$DEST/main/" >>"$LOGFILE" 2>&1
    drop_caches
    differing_files "$list" >"$bad"
    drop_changed "$bad"
    if [ -s "$bad" ]; then
      fail "$(nul_count "$bad") file(s) in the backup still differ from the originals after copying them again${VDRIVES:+ (held by $VDRIVES)}; the backup drive may be failing: see $LOGFILE"
      show_names "$bad" 50 | while IFS= read -r f; do log "verify: still different: $f"; done
    else
      log "verify: the $n file(s) were copied again and now match (the backup drive had damaged them)"
      fail "$n file(s) differed from the originals and were copied again${VDRIVES:+, held by $VDRIVES}. Either the backup drive damaged them or they changed during the backup; if it happens again check the drive with: sudo drives check"
    fi
  else
    log "verify: $total file(s) checked, all match the originals"
  fi
  rm -f "$list" "$bad"
}

# split_newer LIST: take the files whose original is newer than the backup copy out of LIST (NUL-separated) and count them in NEWER_N.
# A file changed after the backup is not a damaged copy: the next backup copies it.
split_newer() {
  local f keep
  NEWER_N=0
  keep=$(mktemp) || return 0
  while IFS= read -r -d '' f; do
    if [ "$SRC/$f" -nt "$DEST/main/$f" ]; then NEWER_N=$((NEWER_N + 1)); else printf '%s\0' "$f"; fi
  done <"$1" >"$keep"
  cat "$keep" >"$1"
  rm -f "$keep"
}

# split_gone LIST: take the names whose original is no longer on Main out of LIST (NUL-separated, changed in place) and print how many there were.
# They cannot be compared, and the next backup moves them to _deleted.
split_gone() {
  python3 - "$1" "$SRC" <<'PY'
import os, sys
path, src = sys.argv[1:3]
names = [n for n in open(path, "rb").read().split(b"\0") if n]
base = os.fsencode(src)
kept = [n for n in names if os.path.lexists(os.path.join(base, n))]
open(path, "wb").write(b"".join(n + b"\0" for n in kept))
print(len(names) - len(kept))
PY
}

# verify_all: compare EVERY file (the `verify` command). With --repair the files that differ are copied again from the originals;
# the version the backup held before is kept in _deleted/<date> like in a nightly run, and a second compare says what is still different.
verify_all() {
  local all bad n left
  all=$(mktemp) || return 1
  bad=$(mktemp) || return 1
  ( cd "$DEST/main" && find . -type f -print0 ) | sed -z 's|^\./||' >"$all"
  VGONE=$(split_gone "$all" 2>/dev/null || echo 0)
  VCOMPARED=$(tr -cd '\0' <"$all" | wc -c)   # find -print0 ends every name with a NUL, so the NULs are the files
  if [ "${VGONE:-0}" -gt 0 ] 2>/dev/null; then
    log "verify: $VGONE file(s) are in the backup but no longer on Main, so they were not compared (the next backup moves them to _deleted)"
    echo "$VGONE file(s) are in the backup but no longer on Main. That is normal: the next backup moves them to _deleted." >&2
  fi
  drop_caches
  echo "Comparing every file (this reads all the data on both drives)..." >&2
  differing_files "$all" >"$bad"
  split_newer "$bad"
  VCHANGED=$NEWER_N
  n=$(nul_count "$bad")
  VDIFF=$n
  if [ "$n" -eq 0 ]; then
    log "verify: every file matches$([ "$VCHANGED" -gt 0 ] && echo " ($VCHANGED changed since the backup)")"
    rm -f "$all" "$bad"
    return 0
  fi
  VDRIVES=$(drives_holding "$bad")
  echo "$n file(s) in the backup differ from the originals${VDRIVES:+ (held by $VDRIVES)}, and the originals did not change since the backup:" >&2
  show_names "$bad" 50 >&2
  if [ "$REPAIR" = 1 ]; then
    mkdir -p "$DEST/_deleted/$TODAY/main"
    rsync -aH --numeric-ids --checksum --from0 --files-from="$bad" \
      --backup --backup-dir="$DEST/_deleted/$TODAY/main" "$SRC/" "$DEST/main/" >>"$LOGFILE" 2>&1
    drop_caches
    left=$(mktemp) || left=/dev/null
    differing_files "$all" >"$left"
    split_newer "$left"
    # only the files that were listed can still differ in a way that matters; count the ones that still do
    VFIXED=$(( n - $(names_in_both "$bad" "$left") ))
    if [ -s "$left" ]; then
      echo "$VFIXED file(s) were copied again from the originals; $(nul_count "$left") still differ. The old versions are kept in _deleted/$TODAY for 30 days." >&2
      fail "$(nul_count "$left") file(s) in the backup still differ from the originals after copying them again"
    else
      echo "$n file(s) were copied again from the originals and now match. The old versions are kept in _deleted/$TODAY for 30 days." >&2
      log "verify: $n file(s) repaired"
    fi
    [ "$left" = /dev/null ] || rm -f "$left"
  else
    echo "To copy them again:  sudo homelab-backup verify --repair" >&2
    fail "$n file(s) in the backup differ from the originals${VDRIVES:+ (held by $VDRIVES)}"
  fi
  rm -f "$all" "$bad"
}

backup_drive_timers() {
  command -v hdparm >/dev/null 2>&1 || return 0
  local mp src dsk
  for mp in "${HOMELAB_DISKS_DIR:-/mnt/disks}"/BACKUP*; do
    case "$mp" in *BOOT) continue ;; esac
    mountpoint -q "$mp" 2>/dev/null || continue
    src=$(findmnt -no SOURCE "$mp" 2>/dev/null) || continue
    dsk=$(lsblk -no pkname "$src" 2>/dev/null | head -n 1)
    [ -n "$dsk" ] && hdparm -S "$1" "/dev/$dsk" >/dev/null 2>&1
  done
  return 0
}
backup_drive_timers 0
trap 'backup_drive_timers 120' EXIT

if mountpoint -q "$DEST_POOL"; then
  DEST="$DEST_POOL"
elif [ -n "$DEST_FALLBACK" ]; then
  # The fallback folder sits inside a folder that belongs to a normal user, who could swap any part of its path for a link, or the folder itself for a folder of their own, while this runs as root.
  # A helper opens the path one part at a time (a link made by a normal user anywhere in it is refused), makes the last folder when it is missing, checks that it is a folder owned by root,
  # and keeps it open. Everything below uses it only through that open handle, so nothing can be swapped in afterwards.
  PIN_PY=$(cat <<'PY'
import os, stat, sys


def pin(folder):
    parts = [p for p in os.path.abspath(folder).split("/") if p]
    fd = os.open("/", os.O_RDONLY | os.O_DIRECTORY)
    hops = 0
    while parts:
        name = parts.pop(0)
        try:
            st = os.stat(name, dir_fd=fd, follow_symlinks=False)
        except FileNotFoundError:
            os.mkdir(name, 0o755, dir_fd=fd)
            st = os.stat(name, dir_fd=fd, follow_symlinks=False)
        if stat.S_ISLNK(st.st_mode):
            hops += 1
            if hops > 32 or st.st_uid != 0 or not parts:
                raise OSError("a link")
            target = os.readlink(name, dir_fd=fd)
            if target.startswith("/"):
                os.close(fd)
                fd = os.open("/", os.O_RDONLY | os.O_DIRECTORY)
            parts = [p for p in target.split("/") if p] + parts
            continue
        nxt = os.open(name, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW, dir_fd=fd)
        os.close(fd)
        fd = nxt
    return fd


try:
    handle = pin(sys.argv[1])
    st = os.fstat(handle)
    if not stat.S_ISDIR(st.st_mode) or st.st_uid != 0:
        raise OSError("not owned by root")
    print("OK %d" % handle, flush=True)
except OSError:
    print("REFUSED", flush=True)
    sys.exit(1)
sys.stdin.read()
PY
)
  coproc PINH { exec python3 -c "$PIN_PY" "$DEST_FALLBACK"; }
  PIN_ANSWER=""
  read -r -t 30 PIN_ANSWER <&"${PINH[0]}" || true
  DEST_SHOWN="$DEST_FALLBACK"
  case "$PIN_ANSWER" in
    "OK "[0-9]*)
      DEST="/proc/$PINH_PID/fd/${PIN_ANSWER#OK }"
      log "backup pool not mounted, using the fallback folder $DEST_SHOWN" ;;
    *)
      DEST=""
      fail "the fallback folder $DEST_FALLBACK is not a real folder owned by root (a link, in it or above it, or another owner), so nothing was copied"
      finish ;;
  esac
else
  fail "backup storage ($DEST_POOL) is not mounted and no fallback is set"
  finish
fi

if ! mountpoint -q "$SRC"; then
  fail "main storage ($SRC) is not mounted, nothing was copied"
  finish
fi
if [ -z "$(find "$SRC" -mindepth 1 -maxdepth 1 ! -name lost+found -print -quit)" ]; then
  fail "main storage ($SRC) looks empty, nothing was copied (this protects the backup from being emptied)"
  finish
fi

renice -n 19 -p $$ >/dev/null 2>&1 || true
ionice -c3 -p $$ >/dev/null 2>&1 || true

free_gb=$(( $(df -B1 --output=avail "$DEST" | tail -1 | tr -d ' ') / 1073741824 ))
# The spare space is 20 GB, but on a small backup drive it is a tenth of the drive (at least 1 GB), so a small drive can still hold backups.
total_gb=$(( $(df -B1 --output=size "$DEST" | tail -1 | tr -d ' ') / 1073741824 ))
floor_gb=$MIN_FREE_GB
[ $(( total_gb / 10 )) -lt "$floor_gb" ] && floor_gb=$(( total_gb / 10 ))
[ "$floor_gb" -ge 1 ] || floor_gb=1
if [ "$MODE" = backup ] || [ "$REPAIR" = 1 ]; then
  if [ "$free_gb" -lt "$floor_gb" ]; then
    fail "only ${free_gb} GB free at ${DEST_SHOWN:-$DEST} (need at least $floor_gb)"
    finish
  fi
  if [ ! -d "$DEST/main" ]; then
    used_gb=$(( $(df -B1 --output=used "$SRC" | tail -1 | tr -d ' ') / 1073741824 ))
    if [ "$free_gb" -lt $(( used_gb + floor_gb )) ]; then
      fail "first backup needs about ${used_gb} GB plus $floor_gb GB spare, but only ${free_gb} GB are free at ${DEST_SHOWN:-$DEST}"
      finish
    fi
  fi
fi
mkdir -p "$DEST/main" "$DEST/boot-configs" "$DEST/db-dumps" "$DEST/_deleted/$TODAY"
# files that an earlier, interrupted run left half written
rm -rf "$DEST/.rsync-tmp"; mkdir -p "$DEST/.rsync-tmp"
rm -f "$DEST"/db-dumps/*.tmp

if [ "$MODE" = verify ]; then
  verify_all
  finish
fi

if docker info >/dev/null 2>&1 && docker ps --format '{{.Names}}' | grep -qx "$NEXTCLOUD_DB_CONTAINER"; then
  dump="$DEST/db-dumps/nextcloud-$TODAY.sql.gz"
  if ( umask 077; docker exec "$NEXTCLOUD_DB_CONTAINER" pg_dump -U "$NEXTCLOUD_DB_USER" "$NEXTCLOUD_DB_NAME" | gzip -c >"$dump.tmp" ) \
     && gzip -t "$dump.tmp" && [ "$(stat -c %s "$dump.tmp")" -gt 1024 ]; then
    mv "$dump.tmp" "$dump"
    chmod 600 "$dump"
    log "database dump saved: ${dump/"$DEST"/"${DEST_SHOWN:-$DEST}"}"
  else
    rm -f "$dump.tmp"
    fail "the Nextcloud database dump failed"
  fi
else
  fail "container $NEXTCLOUD_DB_CONTAINER is not running, database not dumped"
fi

changed=$(mktemp)
rsync -aHS --numeric-ids --delete --exclude=/lost+found \
  --temp-dir="$DEST/.rsync-tmp" \
  --backup --backup-dir="$DEST/_deleted/$TODAY/main" \
  --out-format='%i|%n' "$SRC/" "$DEST/main/" 2>>"$LOGFILE" | rsync_names >"$changed"
rc=${PIPESTATUS[0]}
if rsync_ok "$rc"; then log "main storage copied"; else fail "rsync of main storage exited with code $rc"; fi
verify_sample "$changed"
rm -f "$changed"
rm -rf "$DEST/.rsync-tmp"
find "$DEST/db-dumps" -maxdepth 1 -type f -name 'nextcloud-*.sql.gz' -perm /077 -exec chmod 600 {} + 2>/dev/null

for p in "${CONFIG_PATHS[@]}"; do
  if [ ! -e "$p" ]; then log "config path not found, skipped: $p"; continue; fi
  rsync -aHR --numeric-ids --delete \
    --backup --backup-dir="$DEST/_deleted/$TODAY/boot-configs" \
    "$p" "$DEST/boot-configs/" >>"$LOGFILE" 2>&1
  rc=$?
  rsync_ok "$rc" || fail "rsync of $p exited with code $rc"
done
crontab -l >"$DEST/boot-configs/root-crontab.txt" 2>/dev/null || true
log "configs copied"

find "$DEST/db-dumps" -maxdepth 1 -type f -name 'nextcloud-*.sql.gz' -mtime +"$RETENTION_DAYS" -delete
if [ -d "$DEST/_deleted" ]; then
  find "$DEST/_deleted" -mindepth 1 -maxdepth 1 -type d -mtime +"$RETENTION_DAYS" -exec rm -rf {} +
  find "$DEST/_deleted/$TODAY" -type d -empty -delete 2>/dev/null || true
fi

finish
