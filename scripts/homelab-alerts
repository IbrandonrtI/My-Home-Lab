#!/usr/bin/env python3
"""homelab-alerts - collects what needs attention and writes it to one small file, alerts.json, for the bell on the dashboard.

  homelab-alerts          look at everything and rewrite the file (cron runs it every 5 minutes)
  homelab-alerts show     look and print what it found, write nothing
  homelab-alerts help

What it looks at: containers that are not running, services that run but whose page does not answer, a backup drive that is set up but not connected, copies that the last backup verify found different, container updates waiting (the list homelab-update saved), system updates and a needed
restart, the drives and the backup (from stats.json), free space, Tailscale, drive temperatures, and files being written to a storage pool (an upload or a setup). Every kind can be missing (a tool that is not
installed, a file that is not there yet) and then it is skipped. It changes nothing on the machine and needs no internet.

The file is images/alerts.json in the Homepage folder (the same place as stats.json). Each item has an id, a level (bad, warn or info), a title,
a detail and an action the bell can offer ("update", "restart" or ""). Settings by environment (for tests): HOMELAB_STATE_DIR, HOMELAB_ALERTS_OUT,
HOMELAB_STATS_IN, HOMELAB_DOCKER, HOMELAB_TAILSCALE, HOMELAB_APT_GET, HOMELAB_REBOOT_FILE, HOMELAB_ROOT_PATH, HOMELAB_TEMP_WARN, HOMELAB_TEMP_BAD, HOMELAB_BUSY (none or any text), HOMELAB_POOL_DEVS, HOMELAB_SYS_BLOCK, HOMELAB_BUSY_SECS, HOMELAB_FSTAB, HOMELAB_BACKUP_POOL, HOMELAB_VERIFY_STATUS, HOMELAB_PAGE_HOST, HOMELAB_SERVICE_PORTS (JSON)."""
import json
import os
import tempfile
import re
import stat
import subprocess
import sys
import time
import urllib.error
import urllib.request
from concurrent.futures import ThreadPoolExecutor

VERSION = "1.0"
STATE_DIR = os.environ.get("HOMELAB_STATE_DIR", "/var/lib/homelab")
DOCKER = os.environ.get("HOMELAB_DOCKER", "docker")
TAILSCALE = os.environ.get("HOMELAB_TAILSCALE", "tailscale")
REBOOT_FILE = os.environ.get("HOMELAB_REBOOT_FILE", "/var/run/reboot-required")
ROOT_PATH = os.environ.get("HOMELAB_ROOT_PATH", "/")
BACKUP_STATUS = os.environ.get("HOMELAB_BACKUP_STATUS", "/var/lib/homelab-backup/last-run")
APT_GET = os.environ.get("HOMELAB_APT_GET", "apt-get")
FSTAB = os.environ.get("HOMELAB_FSTAB", "/etc/fstab")
BACKUP_POOL = os.environ.get("HOMELAB_BACKUP_POOL", "/mnt/backup")
VERIFY_STATUS = os.environ.get("HOMELAB_VERIFY_STATUS", os.path.join(os.path.dirname(BACKUP_STATUS), "last-verify"))
PAGE_HOST = os.environ.get("HOMELAB_PAGE_HOST", "127.0.0.1")
PAGE_RETRY_SECONDS = float(os.environ.get("HOMELAB_PAGE_RETRY_SECONDS", "12"))
DOWNTIFY_PORT = int(os.environ.get("HOMELAB_DOWNTIFY_PORT", "8000"))
# The web address of every service the lab installs: container name and the port on this machine. A container that runs but whose page does not answer
# is a service the person cannot use, and Docker alone does not say so.
SERVICE_PORTS = {"homepage": 3001, "portainer": 9000, "adguardhome": 3000, "beszel": 8090, "netdata-netdata-1": 19999, "speedtest-tracker": 8088,
                 "filebrowser-filebrowser-1": 8081, "immich_server": 2283, "nextcloud": 8082, "downtify": 8000, "metube": 8185, "navidrome": 4533, "jellyfin": 8096}
if os.environ.get("HOMELAB_SERVICE_PORTS"):  # tests: replaces the table
    SERVICE_PORTS = json.loads(os.environ["HOMELAB_SERVICE_PORTS"])
ORDER = {"bad": 0, "warn": 1, "info": 2}


def run(cmd, timeout=20):
    try:
        p = subprocess.run(cmd, capture_output=True, text=True, timeout=timeout)
        return p.returncode, p.stdout
    except (OSError, subprocess.SubprocessError):
        return 127, ""


def read(path):
    try:
        with open(path, encoding="utf-8", errors="replace") as f:
            return f.read()
    except OSError:
        return ""


def load_json(path):
    try:
        with open(path, encoding="utf-8") as f:
            data = json.load(f)
        return data if isinstance(data, dict) else {}
    except (OSError, ValueError):
        return {}


def shown_stamp(stamp):
    """A "YYYY-MM-DD HH:MM" time written by the backup program (server time) shown in the zone the dashboard uses, with the zone's name."""
    try:
        t = time.strptime(stamp, "%Y-%m-%d %H:%M")
        secs = time.mktime(t)
    except (ValueError, OverflowError):
        return stamp
    parts = read(os.path.join(STATE_DIR, "display-timezone")).split()
    zone = None
    if len(parts) >= 2 and parts[1] != "none":
        try:
            import zoneinfo
            zone = zoneinfo.ZoneInfo(parts[1])
        except Exception:
            zone = None
    import datetime
    when = datetime.datetime.fromtimestamp(secs).astimezone(zone) if zone else datetime.datetime.fromtimestamp(secs).astimezone()
    return when.strftime("%Y-%m-%d %H:%M %Z")


def item(iid, level, title, detail="", action=""):
    return {"id": iid, "level": level, "title": title, "detail": detail, "action": action}


def nice(name):
    words = re.sub(r"-\d+\Z", "", name).replace("_", " ").replace("-", " ").strip()
    return words[:1].upper() + words[1:]


def homepage_dir():
    saved = read(os.path.join(STATE_DIR, "homepage-dir")).strip()
    if saved and os.path.isdir(saved):
        return saved
    rc, out = run([DOCKER, "inspect", "homepage", "--format", '{{range .Mounts}}{{if eq .Destination "/app/config"}}{{.Source}}{{end}}{{end}}'], 10)
    out = out.strip()
    if rc == 0 and out and os.path.isdir(out):
        return out
    for line in read("/etc/passwd").splitlines():
        f = line.split(":")
        if len(f) > 5 and f[2] == "1000" and os.path.isdir(os.path.join(f[5], "homepage-config")):
            return os.path.join(f[5], "homepage-config")
    return ""


def out_path():
    forced = os.environ.get("HOMELAB_ALERTS_OUT")
    if forced:
        return forced
    hp = homepage_dir()
    return os.path.join(hp, "images", "alerts.json") if hp else ""


def stats_path():
    forced = os.environ.get("HOMELAB_STATS_IN")
    if forced:
        return forced
    hp = homepage_dir()
    return os.path.join(hp, "images", "stats.json") if hp else ""


def check_containers():
    rc, out = run([DOCKER, "ps", "-a", "--format", "{{.Names}}|{{.State}}|{{.Status}}"])
    if rc != 0:
        return [item("docker", "bad", "Docker does not answer", "The containers cannot be checked. Check that Docker is running.", "")]
    res = []
    for line in out.splitlines():
        f = line.split("|", 2)
        if len(f) < 3 or not f[0]:
            continue
        name, state, status = f[0], f[1], f[2]
        if state != "running":
            res.append(item("down:" + name, "bad", "%s is not running" % nice(name), status, ""))
        elif "(unhealthy)" in status:
            res.append(item("sick:" + name, "warn", "%s is not healthy" % nice(name), status, ""))
    return res


def check_panel():
    """The control panel and the web terminal are services of the machine, not containers, so the container check cannot see them."""
    res = []
    for unit, label in (("homelab-panel", "The control panel"), ("homelab-terminal", "The web terminal")):
        rc, txt = run(["systemctl", "list-unit-files", unit + ".service"], 10)
        if rc != 0 or unit not in txt:
            continue
        rc, txt = run(["systemctl", "is-active", unit], 10)
        if txt.strip() != "active":
            res.append(item("down:" + unit, "bad", "%s is not running" % label, "Start it with: sudo systemctl start %s" % unit, ""))
    return res


def apt_waiting():
    rc, out = run([APT_GET, "-s", "upgrade"], 40)
    if rc != 0:
        return None
    return sum(1 for l in out.splitlines() if l.startswith("Inst "))


def check_updates():
    lines = [l for l in read(os.path.join(STATE_DIR, "image-updates")).splitlines()[1:] if l.strip()]
    res = []
    if lines:
        names = ", ".join(l.split()[0] for l in lines[:6]) + (" and more" if len(lines) > 6 else "")
        res.append(item("updates:containers", "info", "%d container update%s waiting" % (len(lines), "" if len(lines) == 1 else "s"), names, "update"))
    apt = read(os.path.join(STATE_DIR, "apt")).strip().split("|")
    n = int(apt[0]) if apt and apt[0].isdigit() else 0
    live = apt_waiting()
    if live is not None:
        n = live
    if n:
        res.append(item("updates:system", "info", "%d system update%s waiting" % (n, "" if n == 1 else "s"), "Ubuntu or Mint packages", "update"))
    if os.path.exists(REBOOT_FILE):
        res.append(item("restart", "warn", "A restart is needed", "A system update requires it. Restart when nothing important is running.", "update"))
    return res


def stats_items():
    """Turn the saved readings into alerts: pool not connected, drive problem, pool almost full, last backup failed or older than 36 hours."""
    st = load_json(stats_path())
    res = []
    if not st:
        return res
    main, backup = st.get("main") or {}, st.get("backup") or {}
    for key, label, req in (("main", "Main pool", True), ("backup", "Backup pool", False)):
        blk = main if key == "main" else backup
        pct, health = str(blk.get("percent", "")), str(blk.get("health", ""))
        if pct == "Not connected":
            if not req and backup_drive_configured():
                continue
            res.append(item(key + ":missing", "bad" if req else "info", "%s is not connected" % label,
                            "No drive is connected there." if req else "Connect a drive in the Drives tab to get backups on a second drive.", "drives"))
            continue
        if health.startswith("PROBLEM"):
            res.append(item(key + ":health", "bad", "%s has a drive with a problem" % label, "Open the Drives tab and check the drives.", "drives"))
        m = re.match(r"(\d+)%", pct)
        if m and int(m.group(1)) >= 90:
            res.append(item(key + ":space", "bad" if int(m.group(1)) >= 95 else "warn", "%s is %s full" % (label, pct), "Free: %s" % blk.get("free", "-"), "drives"))
    last = st.get("last_backup") or {}
    run = (read(BACKUP_STATUS).strip().splitlines() or [""])[0].split("|")
    if len(run) >= 2 and run[0].strip():  # the run record is read directly: the saved readings can be up to 15 minutes old
        failed, when = run[1].strip().upper() != "OK", run[0].strip()
    else:
        failed, when = str(last.get("result", "")).startswith("Failed"), last.get("when", "")
    if failed:
        res.append(item("backup:failed", "bad", "The last backup failed", "%s. Open the Backups section of the Drives tab." % shown_stamp(when), "drives"))
    else:
        try:
            t = time.mktime(time.strptime(run[0], "%Y-%m-%d %H:%M"))
            if time.time() - t > 36 * 3600:
                res.append(item("backup:late", "warn", "No backup for more than a day", "The last one was %s." % (last.get("when") or run[0]), "drives"))
        except (IndexError, ValueError, OverflowError):
            pass
    return res


def backup_drives_configured():
    """The backup drives (BACKUP2, BACKUP3) that /etc/fstab holds. A drive removed with `drives disconnect` is no longer listed there."""
    found = []
    for line in read(FSTAB).splitlines():
        f = line.split()
        if len(f) > 1 and not f[0].startswith("#") and re.search(r"/BACKUP\d+/?$", f[1]):
            found.append(f[1].rstrip("/"))
    return found


def backup_drive_configured():
    return bool(backup_drives_configured())


def check_backup_drive():
    """A backup drive that is set up but not mounted is seen at once, not only at the next stats reading (every 15 minutes)."""
    if backup_drive_configured() and not os.path.ismount(BACKUP_POOL):
        gone = [os.path.basename(m) for m in backup_drives_configured() if not os.path.ismount(m)]
        name = " " + ", ".join(gone) if gone else ""
        return [item("backup:drive-missing", "warn", "The backup drive%s is not connected" % name,
                     "Backups go to the boot drive until it is back. Check the cable, then run: sudo drives remount. If the drive has failed: sudo drives replace", "drives")]
    return []


def check_backup_verify():
    """The result of the last `homelab-backup verify`: copies that still differ from the originals stay on the bell until a later verify finds every file matching."""
    f = (read(VERIFY_STATUS).strip().splitlines() or [""])[0].split("|") + [""] * 6
    stamp, result, _compared, differ, _fixed, drives = f[:6]
    if not stamp or result.strip().upper() == "OK":
        return []
    where = " Held by %s." % drives.strip() if drives.strip() else ""
    return [item("backup:verify", "warn", "Backup copies differ from the originals", "%s file(s) in the backup did not match when checked on %s.%s To copy them again: sudo homelab-backup verify --repair" % (differ or "Some", shown_stamp(stamp), where), "drives")]


def page_status(port, timeout=4):
    try:
        with urllib.request.urlopen("http://%s:%d/" % (PAGE_HOST, port), timeout=timeout) as r:
            return r.status
    except urllib.error.HTTPError as e:
        return e.code
    except (OSError, ValueError):
        return 0


def fresh_container(status):
    """True for a container that started less than three minutes ago or that Docker still lists as starting (its page may not be ready yet)."""
    if "health: starting" in status:
        return True
    m = re.match(r"Up (Less than a second|a second|\d+ seconds?|About a minute|\d+ minutes?)", status)
    if not m:
        return False
    word = m.group(1)
    if "second" in word or word.startswith("About"):
        return True
    return int(word.split()[0]) < 3


def machine_busy():
    """True while the machine has more work than processors (a backup or a verify is reading the drives, say): pages can then be slow for a minute."""
    try:
        return os.getloadavg()[0] > (os.cpu_count() or 1)
    except OSError:
        return False


def check_pages():
    """A container that runs but whose page does not answer (a status of 0 or 500 and above). Only containers that are running are tried.
    One that started a moment ago is shown as still starting, not as broken."""
    rc, out = run([DOCKER, "ps", "--format", "{{.Names}} {{.Status}}"])
    if rc != 0:
        return []
    status = {}
    for line in out.splitlines():
        name, _, rest = line.strip().partition(" ")
        status[name] = rest
    up = [n for n in status if n in SERVICE_PORTS]
    if not up:
        return []
    with ThreadPoolExecutor(max_workers=8) as pool:
        codes = list(pool.map(lambda n: page_status(SERVICE_PORTS[n]), up))
        slow = [i for i, code in enumerate(codes) if not 0 < code < 500]
        if slow:
            again = list(pool.map(lambda i: page_status(SERVICE_PORTS[up[i]], PAGE_RETRY_SECONDS), slow))
            for i, code in zip(slow, again):
                codes[i] = code
    found = []
    busy = machine_busy()
    for n, code in zip(up, codes):
        if 0 < code < 500:
            continue
        if fresh_container(status[n]):
            found.append(item("starting:" + n, "info", "%s is still starting" % nice(n), "It started a moment ago and its page is not ready yet. This goes away by itself; if it is still here in a few minutes: sudo docker logs --tail 30 %s" % n, ""))
        elif busy:
            found.append(item("slow:" + n, "warn", "%s is slow to answer" % nice(n), "The machine is busy right now, so its page did not answer in time. If this is still here when the machine is quiet: sudo docker logs --tail 30 %s" % n, ""))
        else:
            found.append(item("silent:" + n, "bad", "%s runs but its page does not answer" % nice(n), "Look at what it says: sudo docker logs --tail 30 %s" % n, ""))
    return found


def downtify_default_login():
    """True when Downtify still accepts the public first login (admin / downtify)."""
    body = json.dumps({"username": "admin", "password": "downtify"}).encode()
    req = urllib.request.Request("http://%s:%d/api/auth/login" % (PAGE_HOST, DOWNTIFY_PORT), data=body, method="POST", headers={"Content-Type": "application/json"})
    try:
        with urllib.request.urlopen(req, timeout=10) as r:
            return r.status == 200
    except (OSError, ValueError):
        return False


def check_downtify_login():
    """Downtify starts with a public login. While it still works, anyone on the network can use it. A good result is only looked at again after an hour."""
    rc, out = run([DOCKER, "ps", "--format", "{{.Names}}"])
    if rc != 0 or "downtify" not in out.split():
        return []
    cache = os.path.join(STATE_DIR, "downtify-login-checked")
    try:
        with open(cache) as f:
            when, result = f.read().split()[:2]
        if result == "set" and 0 <= time.time() - float(when) < 3600:
            return []
    except (OSError, ValueError):
        pass
    default = downtify_default_login()
    try:
        write_file_safely(cache, "%d %s\n" % (time.time(), "default" if default else "set"))
    except OSError:
        pass
    if not default:
        return []
    return [item("downtify:login", "warn", "Downtify still has its public sign-in", "Anyone on your network can sign in to Downtify with admin and downtify.",
                 "Open Downtify on port %d and set a new password, or run: sudo homelab-setup refresh" % DOWNTIFY_PORT)]


def check_space():
    try:
        s = os.statvfs(ROOT_PATH)
        pct = int(round(100.0 * (s.f_blocks - s.f_bfree) / (s.f_blocks - s.f_bfree + s.f_bavail))) if s.f_blocks else 0
        free = s.f_bavail * s.f_frsize
    except (OSError, ZeroDivisionError):
        return []
    if pct >= 85:
        return [item("space:boot", "bad" if pct >= 92 else "warn", "The boot drive is %d%% full" % pct, "%.1f GB free. Old Docker images can be removed with 'sudo homelab-update clean'." % (free / 1e9), "")]
    return []


def check_tailscale():
    rc, out = run([TAILSCALE, "status", "--json"], 10)
    if rc == 127:
        return []
    try:
        state = json.loads(out).get("BackendState", "")
    except ValueError:
        state = ""
    if state and state != "Running":
        return [item("tailscale", "bad", "Tailscale is not connected (%s)" % state, "Remote access does not work until Tailscale is reconnected. Try: sudo tailscale up", "")]
    if not state and rc != 0:
        return [item("tailscale", "bad", "Tailscale does not answer", "Remote access may be unavailable. Try: sudo systemctl restart tailscaled", "")]
    return []


def check_temps():
    try:
        warn = int(os.environ.get("HOMELAB_TEMP_WARN", "50"))
        bad = int(os.environ.get("HOMELAB_TEMP_BAD", "60"))
    except ValueError:
        warn, bad = 50, 60
    res = []
    for line in read(os.path.join(STATE_DIR, "temps")).splitlines():
        f = line.split("|")
        if len(f) < 3 or not f[2].isdigit():
            continue
        t = int(f[2])
        if t >= warn:
            res.append(item("temp:" + f[0], "bad" if t >= bad else "warn", "%s is hot: %d°C" % (f[0].capitalize() if f[0].islower() else f[0], t), "Check the airflow around the machine.", ""))
    return res


def pool_devices():
    """The whole disks behind the storage pools and backup drives, found the same way homelab-update finds them."""
    forced = os.environ.get("HOMELAB_POOL_DEVS")
    if forced is not None:
        return forced.split()
    rc, out = run(["findmnt", "-rn", "-o", "SOURCE,TARGET"], 10)
    disks = set()
    for line in out.splitlines():
        f = line.split()
        if len(f) == 2 and f[0].startswith("/dev/") and re.match(r"/mnt/(disks/|storage\Z|backup\Z)", f[1]):
            rc2, name = run(["lsblk", "-no", "pkname", f[0]], 10)
            if rc2 == 0 and name.strip():
                disks.add(name.split()[0])
    return sorted(disks)


def sectors_written(devs):
    total = 0
    for d in devs:
        f = read(os.path.join(os.environ.get("HOMELAB_SYS_BLOCK", "/sys/block"), d, "stat")).split()
        if len(f) > 6 and f[6].isdigit():
            total += int(f[6])
    return total


def check_busy():
    """Files being written to a storage pool, such as an upload or a setup. Its size is not known, so the bell can say it is busy but not when it will end."""
    forced = os.environ.get("HOMELAB_BUSY")
    if forced is not None:
        busy = forced not in ("", "none")
    else:
        devs = pool_devices()
        if not devs:
            return []
        secs = float(os.environ.get("HOMELAB_BUSY_SECS", "5"))
        a = sectors_written(devs)
        time.sleep(secs)
        busy = (sectors_written(devs) - a) * 512 / secs > 300000
    if not busy:
        return []
    return [item("storage:busy", "info", "Files are being written to a storage pool", "Probably an upload or a setup. Its size is not known, so there is no finish time. Updates and drive changes wait until it stops.", "")]


CHECKS = (check_containers, check_panel, check_pages, check_downtify_login, check_updates, stats_items, check_backup_drive, check_backup_verify, check_space, check_tailscale, check_temps, check_busy)


def collect():
    items = []
    for fn in CHECKS:
        try:
            items.extend(fn())
        except Exception as e:
            items.append(item("check:" + fn.__name__, "warn", "A check failed: %s" % fn.__name__, str(e)[:120], ""))
    items.sort(key=lambda i: (ORDER[i["level"]], i["title"]))
    now = int(time.time())
    return {"version": 1, "updated": now, "counts": {k: sum(1 for i in items if i["level"] == k) for k in ORDER}, "items": items}


def drop_old_temp_files(folder, base, older=3600):
    """A job that was stopped between making its temporary file and swapping it in leaves that file behind; leftovers of this file older than an hour are removed."""
    prefix = ".%s." % base
    try:
        for name in os.listdir(folder):
            p = os.path.join(folder, name)
            if name.startswith(prefix) and name.endswith(".tmp") and not os.path.islink(p) and os.path.isfile(p) and time.time() - os.lstat(p).st_mtime > older:
                os.unlink(p)
    except OSError:
        pass


def pin_folder(folder):
    """Open a folder one part at a time and return an open handle to it. A link at the last part is refused, and so is a link higher up unless root made it,
    so a normal user who owns an upper folder cannot swap it for a link. Use the folder as /proc/self/fd/<handle> afterwards, so nothing can be swapped in later."""
    parts = [p for p in os.path.abspath(folder).split("/") if p]
    fd = os.open("/", os.O_RDONLY | os.O_DIRECTORY)
    hops = 0
    try:
        while parts:
            name = parts.pop(0)
            st = os.stat(name, dir_fd=fd, follow_symlinks=False)
            if stat.S_ISLNK(st.st_mode):
                hops += 1
                if hops > 32 or st.st_uid != 0 or not parts:
                    raise OSError("the part '%s' of %s is a link, so nothing was written there" % (name, folder))
                target = os.readlink(name, dir_fd=fd)
                if target.startswith("/"):
                    os.close(fd)
                    fd = os.open("/", os.O_RDONLY | os.O_DIRECTORY)
                parts = [p for p in target.split("/") if p] + parts
                continue
            nxt = os.open(name, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW, dir_fd=fd)
            os.close(fd)
            fd = nxt
        return fd
    except BaseException:
        os.close(fd)
        raise


def write_file_safely(path, text, mode=0o644, owner=None, make_folder=False):
    """Write a file through a temporary file whose name nobody can guess or plant a link at (the folder may belong to a normal user while this runs as root).
    Every folder on the way is checked, mode and owner are set on the open file, never on a path, and the finished file is swapped in; a link at the final name is replaced, not followed."""
    if make_folder:
        # Only the last folder is made, and only inside a parent that was checked first (a link higher up is refused), never with os.makedirs.
        where = os.path.abspath(os.path.dirname(path) or ".")
        parent = pin_folder(os.path.dirname(where))
        try:
            os.mkdir(os.path.basename(where), 0o755, dir_fd=parent)
        except FileExistsError:
            pass
        finally:
            os.close(parent)
    handle = pin_folder(os.path.dirname(path) or ".")
    try:
        folder = "/proc/self/fd/%d" % handle
        fd, tmp = tempfile.mkstemp(prefix=".%s." % os.path.basename(path), suffix=".tmp", dir=folder)
        try:
            with os.fdopen(fd, "w", encoding="utf-8", newline="") as f:
                f.write(text)
                f.flush()
                os.fchmod(f.fileno(), mode)
                if owner is not None and os.geteuid() == 0:
                    os.fchown(f.fileno(), owner[0], owner[1])
            os.replace(tmp, os.path.join(folder, os.path.basename(path)))
            drop_old_temp_files(folder, os.path.basename(path))
        except BaseException:
            try:
                os.unlink(tmp)
            except OSError:
                pass
            raise
    finally:
        os.close(handle)


def save(res, path):
    write_file_safely(path, json.dumps(res, indent=1), make_folder=True)


def main(argv):
    """Read the command line and run the requested command."""
    cmd = argv[0] if argv else "run"
    if cmd in ("help", "--help", "-h"):
        print(__doc__)
        return 0
    if cmd in ("version", "--version"):
        print("homelab-alerts %s" % VERSION)
        return 0
    if cmd not in ("run", "show", "silent", "downtify"):
        sys.stderr.write("Unknown option: %s\n%s\n" % (cmd, "Use: homelab-alerts [show|silent|downtify|help|version]"))
        return 1
    if cmd == "silent":  # used by `homelab`: names of containers that run but whose page does not answer, one per line
        for i in check_pages():
            if i["id"].startswith("silent:"):
                print(i["id"].split(":", 1)[1])
        return 0
    if cmd == "downtify":  # used by `homelab`: prints "default" when Downtify still accepts the public first login
        rc, names = run([DOCKER, "ps", "--format", "{{.Names}}"])
        if rc == 0 and "downtify" in names.split() and downtify_default_login():
            print("default")
        return 0
    res = collect()
    if cmd == "show":
        for i in res["items"]:
            print("%-5s %-28s %s" % (i["level"], i["title"], i["detail"]))
        if not res["items"]:
            print("Nothing needs attention.")
        return 0
    path = out_path()
    if not path:
        sys.stderr.write("homelab-alerts: the Homepage folder was not found, nothing written.\n")
        return 1
    try:
        save(res, path)
    except OSError as err:
        sys.stderr.write("homelab-alerts: %s\n" % err)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
